DATABASE_URL=postgresql+asyncpg://cattle:cattle@localhost:5432/cattle_reid
FAISS_INDEX_PATH=./data/faiss_index
SQL_ECHO=false

# MinIO (API na mesma stack; da máquina host use porta 6300 -> 9000 no container)
# O projeto carrega `<repo>/.env` com prioridade sobre export na shell (evita MINIO_PORT=9000 “preso”).
MINIO_ENABLED=true
MINIO_ENDPOINT=localhost
MINIO_PORT=6300
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin123
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin123
MINIO_USE_SSL=false
MINIO_BUCKET=images
# Alinhar com cattle-api quando usar buckets distintos (útil com um único MinIO partilhado)
# MINIO_BUCKET_VIDEOS=images
# MINIO_BUCKET_THUMBNAILS=images
# MINIO_BUCKET_CROPS=images
MINIO_BASE_URL=http://localhost:6300

# Usar os mesmos MINIO_ENDPOINT/PORT/ACCESS_KEY/SECRET/BUCKET(s) que cattle-api (uma única instância MinIO para recortes + vídeos do portal).

# Se a API rodar dentro do Docker na rede cattle-net, use:
# MINIO_ENDPOINT=cattle-minio
# MINIO_PORT=9000
# MINIO_BASE_URL=http://cattle-minio:9000